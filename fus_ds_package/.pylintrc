[MAIN]
# unifus is a compiled native extension (.pyd); pylint cannot introspect its
# members via static analysis, so every unifus.X access is otherwise flagged
# as c-extension-no-member.
extension-pkg-allow-list=fus_driving_systems.igt.unifus

[MESSAGES CONTROL]
disable=
    # The codebase deliberately uses f-strings in log calls throughout;
    # switching to %-style lazy formatting is not planned.
    logging-not-lazy,
    logging-fstring-interpolation,
    # Complexity is inherent to this package's domain (driving-system config,
    # protocol timing/power/focus logic) -- it shows up package-wide (calc_utils.py,
    # driving_system.py, transducer.py, transducer_slot.py, tus_protocol.py, utils.py,
    # igt_ds.py, igt/utils.py, igt/transducer_xyz.py), not just in one class. The
    # TransducerSlot extraction already split out what could be split without
    # fragmenting logic that benefits from staying in one place (e.g. configure_timing()'s
    # single-call design, chosen specifically to avoid ordering-hazard bugs) -- it moved
    # complexity into the new file rather than eliminating it. Disabled package-wide rather
    # than suppressed line-by-line; revisit only where a concrete pain point (a bug, a
    # hard-to-test path) points at a specific function, not against these thresholds alone.
    too-many-arguments,
    too-many-positional-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-instance-attributes,
    too-many-public-methods,
    too-many-lines,
    too-many-boolean-expressions,

# Note on naming: igt/utils.py's ExecListener subclasses the native
# unifus.FUSListener and must override its callback methods (onConnectStart,
# onPulseResult, etc.) using their exact camelCase names -- the C extension
# calls back into these by name, so renaming them to snake_case would
# silently break the callback mechanism. This is a functional requirement,
# not a style choice. Rather than a codebase-wide good-names-rgxs exemption
# (which would also apply to unrelated code), each of the 10 affected
# methods carries its own inline
# "# pylint: disable=invalid-name"/"# pylint: disable-next=invalid-name".
